#version 450
#extension GL_EXT_shader_image_load_formatted : require

// SDR content drawn into an HDR output (see `src/shell/render/hdr_shader.rs`).
//
// This is a custom texture program for smithay's Vulkan renderer: a copy of its
// `texture.glsl` (src/backend/renderer/vulkan/shaders/) with `process()`
// replaced and two uniforms appended to the push constant block. Keep the
// bindings, the push constant layout and `main()` identical to that shader.
// Run `compile.sh` after a change and commit the `.spv`.

layout(
local_size_x = 8,
local_size_y = 8,
local_size_z = 1
) in;

layout(binding = 0) uniform image2D dst;
layout(binding = 1) uniform sampler2D tex;
layout(push_constant, std140) uniform PushConstants {
    // Maps a framebuffer pixel position to texture coordinates.
    vec4 uvX;
    vec4 uvY;
    uint reserved;
    float alpha;
    // Bit 0: DebugFlags::TINT. Bit 31: the texture has no alpha channel.
    uint flags;

    uint damageSize;
    ivec4 damage[4];

    // Custom uniforms, from `VulkanRenderer::CUSTOM_UNIFORMS_OFFSET`.
    // SDR white in nits, and 1.0 for a PQ output, 0.0 for scRGB.
    float sdrWhiteNits;
    float pqOutput;
} params;

const uint DEBUG_TINT = 1u;
const uint OPAQUE = 0x80000000u;

vec3 bt709_to_bt2020(vec3 c) {
    return vec3(
        dot(vec3(0.6274039, 0.3292830, 0.0433131), c),
        dot(vec3(0.0690973, 0.9195404, 0.0113623), c),
        dot(vec3(0.0163914, 0.0880133, 0.8955953), c));
}

// SMPTE ST 2084 inverse EOTF of absolute luminance in nits.
vec3 pq_encode(vec3 nits) {
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    vec3 y = clamp(nits / 10000.0, 0.0, 1.0);
    vec3 ym = pow(y, vec3(m1));
    vec3 ratio = (c1 + c2 * ym) / (1.0 + c3 * ym);
    return pow(ratio, vec3(m2));
}

vec4 process(vec4 color) {
    // Buffers are premultiplied; convert the colour, not the coverage.
    vec3 srgb = color.a > 0.0 ? clamp(color.rgb / color.a, 0.0, 1.0) : vec3(0.0);
    vec3 linear = pow(srgb, vec3(2.2));

    vec3 encoded;
    if (params.pqOutput > 0.5) {
        encoded = pq_encode(bt709_to_bt2020(linear) * params.sdrWhiteNits);
    } else {
        encoded = linear * (params.sdrWhiteNits / 80.0);
    }
    return vec4(encoded * color.a, color.a);
}

void main() {
    uvec2 coord = uvec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);

    // Sample at the pixel centre. The damage rectangles are already clipped to the element.
    vec3 pos = vec3(vec2(coord) + 0.5, 1.0);
    vec2 uv = vec2(dot(params.uvX.xyz, pos), dot(params.uvY.xyz, pos));

    for (int i = 0; i < params.damageSize; i++) {
        ivec4 rect = params.damage[i];

        if (coord.x >= rect.x && coord.x < (rect.x + rect.z) &&
            coord.y >= rect.y && coord.y < (rect.y + rect.w))
        {
            // Compute shaders have no derivatives: sample LOD 0, the renderer selects the filter.
            vec4 sampled = textureLod(tex, uv, 0.0);
            if ((params.flags & OPAQUE) != 0) {
                // The padding bits of formats such as XRGB8888 are undefined.
                sampled.a = 1.0;
            }
            vec4 color = process(sampled) * params.alpha;
            if (color.a < 1.0) {
                // Premultiplied "over": src + dst * (1 - src.a).
                color = color + imageLoad(dst, ivec2(coord)) * (1.0 - color.a);
            }
            if ((params.flags & DEBUG_TINT) != 0) {
                color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
            }
            imageStore(dst, ivec2(coord), color);
            break;
        }
    }
}
